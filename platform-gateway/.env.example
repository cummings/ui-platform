# Copy to .env (docker compose reads it automatically).

# "docker" = every app runs in compose; "dev" = gateway in docker, apps on your laptop (pnpm dev).
UPSTREAMS=docker

# Auth — identical in every app and API.
AUTH_MODE=mock
AUTH_SECRET=core-platform-mock-secret-local-dev-only-0000
APP_BASE_URL=http://localhost:8080
# AUTH_MODE=auth0
# AUTH0_DOMAIN=your-tenant.eu.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_AUDIENCE=https://api.platform.company.com
# AUTH0_ROLES_CLAIM=https://platform.company.com/roles

# Where team image builds fetch @core/* packages from.
CORE_REGISTRY=http://host.docker.internal:4873

# Local Verdaccio publisher (scripts/registry-token.sh). Test values for local dev only.
REGISTRY_USER=platform-ci
REGISTRY_PASSWORD=local-dev-only-password
