{
  "name": "@core/server-auth",
  "version": "0.2.1",
  "description": "Fastify plugin that verifies platform (Auth0 or mock) bearer tokens",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify-plugin": "5.1.0",
    "jose": "6.2.15"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@core/auth": "workspace:*",
    "@core/config": "workspace:*",
    "@types/node": "22.20.5",
    "fastify": "5.12.8",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
