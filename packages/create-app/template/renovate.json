{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Group platform package upgrades into one PR; auto-merge non-major updates that pass CI",
      "matchPackagePatterns": ["^@core/"],
      "groupName": "core platform packages",
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch"]
    }
  ]
}
