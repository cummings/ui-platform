# GENERATED by scripts/generate.mjs from routes.yaml — do not edit by hand.

map $http_x_request_id $platform_request_id {
  default $http_x_request_id;
  ""      $request_id;
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      close;
}

server {
  listen 80;
  server_name _;

  # Resolve upstreams at request time so one app being down never stops the gateway booting.
  resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

  include /etc/nginx/snippets/security-headers.conf;

  location = /healthz {
    access_log off;
    default_type application/json;
    return 200 '{"status":"ok"}';
  }

  # Runtime app registry + gateway error pages.
  location ^~ /platform/ {
    alias /usr/share/nginx/platform/;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=30" always;
  }

  error_page 502 503 504 /platform/unavailable.html;

  location @api_unavailable {
    default_type application/json;
    return 503 '{"error":"service_unavailable","requestId":"$platform_request_id"}';
  }

  # orders API — Team Orders
  location ~ ^/api/orders(/|$) {
    set $upstream "${ORDERS_API_UPSTREAM}";
    proxy_pass http://$upstream;
    include /etc/nginx/snippets/proxy.conf;
    error_page 502 503 504 = @api_unavailable;
  }

  # analytics API — Team Analytics
  location ~ ^/api/analytics(/|$) {
    set $upstream "${ANALYTICS_API_UPSTREAM}";
    proxy_pass http://$upstream;
    include /etc/nginx/snippets/proxy.conf;
    error_page 502 503 504 = @api_unavailable;
  }

  # orders web — Team Orders
  location ~ ^/orders(/|$) {
    set $upstream "${ORDERS_WEB_UPSTREAM}";
    proxy_pass http://$upstream;
    include /etc/nginx/snippets/proxy.conf;
  }

  # analytics web — Team Analytics
  location ~ ^/analytics(/|$) {
    set $upstream "${ANALYTICS_WEB_UPSTREAM}";
    proxy_pass http://$upstream;
    include /etc/nginx/snippets/proxy.conf;
  }

  # home /auth
  location ~ ^/auth(/|$) {
    set $upstream "${HOME_WEB_UPSTREAM}";
    proxy_pass http://$upstream;
    include /etc/nginx/snippets/proxy.conf;
  }

  # home — everything else
  location / {
    set $upstream "${HOME_WEB_UPSTREAM}";
    proxy_pass http://$upstream;
    include /etc/nginx/snippets/proxy.conf;
  }
}
